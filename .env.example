# Copy this file to .env and fill in your own values.
DJANGO_SECRET_KEY=generate-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
CSRF_TRUSTED_ORIGINS=
AI_BACKGROUND_ASYNC=false
HANDSFREE_ENABLED=true
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=MediConnect <noreply@example.com>
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TRIAGE_AI_ENABLED=true
VERIFICATION_AI_ENABLED=true
VERIFICATION_MODEL=gpt-4.1
DOCUMENT_AI_ENABLED=true
DOCUMENT_AI_MODEL=gpt-4.1
PHARMACHECK_AI_ENABLED=true
PHARMACHECK_AI_MODEL=gpt-4.1-mini
PHARMACHECK_AI_TIMEOUT=30
